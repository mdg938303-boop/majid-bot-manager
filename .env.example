# Copy to .env for local development. NEVER commit a real .env.
DATABASE_URL=postgres://user:password@localhost:5432/mbm
DATABASE_SSL=false                     # local only; leave unset on Render
ENCRYPTION_KEY=change-me-to-a-random-string-of-at-least-32-characters
ADMIN_EMAIL=admin@example.com          # first admin, created only if no admin exists
ADMIN_PASSWORD=change-me-now-10plus    # min 10 chars
RENDER_API_KEY=                        # Render Account Settings -> API Keys
RENDER_WORKSPACE_ID=                   # looks like tea-xxxx (workspace/owner id)
RENDER_SANDBOX_GROUP_ID=               # optional: sandbox group to run bots in
PORT=3000
LOG_POLL_SECONDS=5
SESSION_DAYS=7
MAX_UPLOAD_MB=25
# For API tests only:
# API_BASE_URL=http://localhost:3000
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# TEST_BOT_TOKEN=
